<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_securetransfer" model="ir.module.category">
            <field name="name">Transfert sécurisé</field>
            <field name="sequence">36</field>
        </record>

        <record id="group_securetransfer_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="comment">Peut consulter les transferts et leur journal d'accès.</field>
            <field name="category_id" ref="module_category_securetransfer"/>
        </record>

        <record id="group_securetransfer_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="comment">Accès complet : marques, configuration, expiration, purge et révélation des liens.</field>
            <field name="category_id" ref="module_category_securetransfer"/>
            <field name="implied_ids" eval="[(4, ref('group_securetransfer_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- All transfers are created by anonymous visitors (sudo behind
             tokens); there is no per-creator ownership to enforce. Both
             groups therefore see everything — the multi-company rule below
             is the only record-level restriction. -->
        <record id="rule_secure_transfer_user" model="ir.rule">
            <field name="name">Transferts : utilisateur</field>
            <field name="model_id" ref="model_secure_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_securetransfer_user'))]"/>
        </record>

        <record id="rule_secure_transfer_manager" model="ir.rule">
            <field name="name">Transferts : accès complet</field>
            <field name="model_id" ref="model_secure_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_securetransfer_manager'))]"/>
        </record>

        <!-- Standard multi-company isolation (global rule, no groups). -->
        <record id="rule_secure_transfer_company" model="ir.rule">
            <field name="name">Transferts : multi-société</field>
            <field name="model_id" ref="model_secure_transfer"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
