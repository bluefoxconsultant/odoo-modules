<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 3-emoji rating request after a meeting report. Same mechanics as
             project.rating_project_request_email_template: the access token
             creates the rating.rating carrier, the /rate/<token>/<rate> links
             and images are absolutized at send time. Light outer wrapper. -->
        <record id="mail_template_meeting_rating" model="mail.template">
            <field name="name">Expérience client : feedback post-rencontre</field>
            <field name="model_id" ref="bf_meeting.model_meeting_record"/>
            <field name="subject">Comment s'est passée notre rencontre ?</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="background-color:#F8FAFC; padding:24px; font-family:Arial, Helvetica, sans-serif; color:#2D3031;">
    <div style="max-width:560px; margin:0 auto; background-color:#FFFFFF; border-radius:8px; padding:32px;">
        <p style="font-size:15px;">
            Bonjour <t t-out="object.partner_id.name or ''"/>,
        </p>
        <p style="font-size:15px;">
            Nous vous avons transmis le compte rendu de notre rencontre.
            En un clic, comment évaluez-vous nos services jusqu'ici&#160;?
        </p>
        <t t-set="access_token" t-value="object._rating_get_access_token()"/>
        <table role="presentation" style="margin:24px auto; text-align:center;">
            <tr>
                <td style="padding:0 16px;">
                    <a t-attf-href="/rate/{{ access_token }}/5">
                        <img alt="Satisfait" src="/rating/static/src/img/rating_5.png" title="Satisfait"/>
                    </a>
                </td>
                <td style="padding:0 16px;">
                    <a t-attf-href="/rate/{{ access_token }}/3">
                        <img alt="Correct" src="/rating/static/src/img/rating_3.png" title="Correct"/>
                    </a>
                </td>
                <td style="padding:0 16px;">
                    <a t-attf-href="/rate/{{ access_token }}/1">
                        <img alt="Insatisfait" src="/rating/static/src/img/rating_1.png" title="Insatisfait"/>
                    </a>
                </td>
            </tr>
        </table>
        <p style="font-size:13px; color:#6c757d;">
            Un commentaire libre peut être ajouté après le clic. Merci&#160;!
        </p>
    </div>
</div>
            </field>
        </record>
    </data>
</odoo>
