<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Live-sync crons ship INACTIVE. They run against deployment-specific
             paths/credentials that the operator must configure first (see README
             "Synchronisation en continu"). Activate them once configured. -->

        <record id="ir_cron_sms_nc_watch" model="ir.cron">
            <field name="name">Archive SMS &amp; Appels : surveillance dossier Nextcloud</field>
            <field name="model_id" ref="model_sms_archive_import_wizard"/>
            <field name="state">code</field>
            <field name="code">model._cron_nc_watch_import()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <record id="ir_cron_sms_disk_import" model="ir.cron">
            <field name="name">Archive SMS &amp; Appels : import depuis le dossier disque</field>
            <field name="model_id" ref="model_sms_archive_import_wizard"/>
            <field name="state">code</field>
            <field name="code">model._cron_disk_import()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>

    <!-- Config parameters: use function to avoid UniqueViolation on upgrade.
         Placeholder defaults — the operator MUST set these before activating
         the Nextcloud watch cron (see README). An empty nc_watch_path makes the
         watch cron a no-op even if activated. -->
    <function model="ir.config_parameter" name="set_param">
        <value>bf_sms_archive.nc_watch_path</value>
        <value></value>
    </function>
    <function model="ir.config_parameter" name="set_param">
        <value>bf_sms_archive.nc_watch_user_id</value>
        <value>1</value>
    </function>

</odoo>
