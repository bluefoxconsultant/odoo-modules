<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_sms_thread" model="ir.actions.report">
        <field name="name">Conversation SMS (PDF)</field>
        <field name="model">sms.archive.thread</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_sms_archive.report_sms_thread</field>
        <field name="report_file">bf_sms_archive.report_sms_thread</field>
        <field name="print_report_name">'SMS_%s_%s' % (object.phone_normalized.replace('+',''), time.strftime('%Y-%m-%d'))</field>
        <field name="paperformat_id" ref="paperformat_sms_archive"/>
        <field name="binding_model_id" ref="model_sms_archive_thread"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sms_thread">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._get_report_data()"/>
                <div class="article sms-page">
                    <!-- Lexend CSS: only if bf_lexend is installed -->
                    <link t-if="data.get('has_lexend')" rel="stylesheet" href="/bf_lexend/static/src/scss/lexend_report.css"/>
                    <style>
                        /* ── Emoji font (embedded base64 for wkhtmltopdf reliability) ── */
                        @font-face {
                            font-family: "NotoEmoji";
                            src: url("<t t-esc="data.get('emoji_font_uri', '')"/>") format("truetype");
                            font-weight: 400;
                            font-style: normal;
                        }

                        /* ── Brand CSS (colours injected from res.company) ── */
                        <t t-out="data.get('report_css', '')"/>
                    </style>

                    <!-- Banner -->
                    <div class="sms-banner">
                        <div class="sms-banner-logo">
                            <img t-if="data.get('company_logo')" t-att-src="data['company_logo']" alt="Logo"/>
                        </div>
                        <div class="sms-banner-content">
                            <div class="doc-type">Archive SMS</div>
                            <h1><t t-esc="data['contact']"/></h1>
                            <div class="doc-subtitle">
                                <t t-esc="data['phone']"/> —
                                <t t-esc="data['count']"/> messages
                            </div>
                        </div>
                    </div>
                    <div class="sms-accent-bar"/>

                    <!-- Meta -->
                    <div class="sms-meta">
                        <div class="sms-meta-item">
                            <div class="sms-meta-label">Exporté le</div>
                            <div class="sms-meta-value">
                                <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            </div>
                        </div>
                        <div class="sms-meta-item" t-if="data['messages']">
                            <div class="sms-meta-label">Période</div>
                            <div class="sms-meta-value">
                                <t t-esc="str(data['messages'][0].date_sent)[:10]"/> —
                                <t t-esc="str(data['messages'][-1].date_sent)[:10]"/>
                            </div>
                        </div>
                        <div class="sms-meta-item" t-if="doc.partner_id">
                            <div class="sms-meta-label">Contact Odoo</div>
                            <div class="sms-meta-value">
                                <t t-esc="doc.partner_id.name"/>
                            </div>
                        </div>
                    </div>

                    <!-- Messages (chat bubbles via table layout for wkhtmltopdf) -->
                    <div class="sms-messages">
                        <t t-set="prev_date" t-value="''"/>
                        <t t-foreach="data['messages']" t-as="msg">
                            <!-- Date separator -->
                            <t t-set="msg_date" t-value="str(msg.date_sent)[:10]"/>
                            <t t-if="msg_date != prev_date">
                                <div class="sms-date-sep"><t t-esc="msg_date"/></div>
                                <t t-set="prev_date" t-value="msg_date"/>
                            </t>
                            <!-- Received: bubble left -->
                            <div t-if="msg.direction == 'in'" class="sms-row sms-row-left">
                                <div class="sms-bubble sms-bubble-in">
                                    <t t-set="body" t-value="data.get('msg_bodies', {}).get(msg.id, msg.body)"/>
                                    <t t-if="body"><t t-esc="body"/></t>
                                    <t t-foreach="data.get('msg_images', {}).get(msg.id, [])" t-as="img">
                                        <img t-if="img.get('renderable')" class="sms-img" t-att-src="img['data_uri']" t-att-alt="img['filename']"/>
                                        <div t-if="not img.get('renderable')" class="sms-img-placeholder">
                                            [Image <t t-esc="img.get('content_type', '')"/> — télécharger depuis Odoo]
                                        </div>
                                    </t>
                                    <div class="sms-ts"><t t-esc="str(msg.date_sent)[11:16]"/><t t-if="msg.is_mms"> · MMS</t></div>
                                </div>
                            </div>
                            <!-- Sent/Draft: bubble right -->
                            <div t-if="msg.direction != 'in'" class="sms-row sms-row-right">
                                <div t-attf-class="sms-bubble sms-bubble-#{msg.direction}">
                                    <t t-set="body" t-value="data.get('msg_bodies', {}).get(msg.id, msg.body)"/>
                                    <t t-if="body"><t t-esc="body"/></t>
                                    <t t-foreach="data.get('msg_images', {}).get(msg.id, [])" t-as="img">
                                        <img t-if="img.get('renderable')" class="sms-img" t-att-src="img['data_uri']" t-att-alt="img['filename']"/>
                                        <div t-if="not img.get('renderable')" class="sms-img-placeholder">
                                            [Image <t t-esc="img.get('content_type', '')"/> — télécharger depuis Odoo]
                                        </div>
                                    </t>
                                    <div class="sms-ts"><t t-esc="str(msg.date_sent)[11:16]"/><t t-if="msg.is_mms"> · MMS</t></div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Footer -->
                    <div class="sms-footer">
                        <t t-esc="data.get('company_name', '')"/> | Document confidentiel |
                        Exporté le <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
