<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Import Wizard Form -->
    <record id="sms_import_wizard_view_form" model="ir.ui.view">
        <field name="name">sms.archive.import.wizard.form</field>
        <field name="model">sms.archive.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import" string="Importer"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="file_data" filename="file_name"
                                   string="Fichier de sauvegarde SMS (XML ou ZIP)"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="not result_message">
                        <field name="result_message" string="Résultat" readonly="1"
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Import Wizard Action -->
    <record id="sms_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Importer des SMS</field>
        <field name="res_model">sms.archive.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
