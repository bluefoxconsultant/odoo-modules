<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sms_post_to_task_wizard_view_form" model="ir.ui.view">
        <field name="name">sms.archive.post.to.task.wizard.form</field>
        <field name="model">sms.archive.post.to.task.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="message_id" invisible="1"/>
                    <field name="message_preview" string="Message" readonly="1"/>
                </group>
                <group>
                    <field name="project_id" string="Projet"
                           options="{'no_create': True}"/>
                    <field name="task_id" string="Tâche"
                           options="{'no_create': True}"/>
                    <field name="link_thread"
                           string="Lier la conversation à cette tâche"/>
                </group>
                <footer>
                    <button name="action_post" string="Poster sur la tâche"
                            type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
