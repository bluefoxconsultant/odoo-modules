<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Partner Form View with Hosting Services Smart Buttons -->
    <record id="res_partner_view_form_inherit_hosting" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.hosting</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_hosting_services" type="object"
                        class="oe_stat_button" icon="fa-server"
                        invisible="hosting_service_count == 0">
                    <field name="hosting_service_count" widget="statinfo" string="Hosting"/>
                </button>
                <button name="action_view_hosting_services_expiring" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        invisible="hosting_services_expiring_count == 0">
                    <field name="hosting_services_expiring_count" widget="statinfo" string="Expiring"/>
                </button>
                <button name="action_view_hosting_services_updates" type="object"
                        class="oe_stat_button" icon="fa-refresh"
                        invisible="hosting_services_updates_count == 0">
                    <field name="hosting_services_updates_count" widget="statinfo" string="Updates"/>
                </button>
                <button name="action_view_hosting_services_storage_alert" type="object"
                        class="oe_stat_button" icon="fa-database"
                        invisible="hosting_services_storage_alert_count == 0">
                    <field name="hosting_services_storage_alert_count" widget="statinfo" string="Storage Alert"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
