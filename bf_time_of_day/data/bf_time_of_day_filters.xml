<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="filter_my_day_by_slot" model="ir.filters">
            <field name="name">Ma journée par plage</field>
            <field name="model_id">project.task</field>
            <field name="user_id" eval="False"/>
            <field name="domain">[('user_ids', 'in', uid), ('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_deadline', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]</field>
            <field name="context">{'group_by': ['time_of_day_id']}</field>
        </record>

    </data>
</odoo>
