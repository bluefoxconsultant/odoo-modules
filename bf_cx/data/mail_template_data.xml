<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Invitation email for wave sends. Outer wrapper stays LIGHT
             (#F8FAFC): email clients and the sanitizer strip inner card
             backgrounds, dark outers end up unreadable. -->
        <record id="mail_template_cx_invite" model="mail.template">
            <field name="name">Expérience client : invitation au sondage</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Votre avis compte — 2 minutes suffisent</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="background-color:#F8FAFC; padding:24px; font-family:Arial, Helvetica, sans-serif; color:#2D3031;">
    <div style="max-width:560px; margin:0 auto; background-color:#FFFFFF; border-radius:8px; padding:32px;">
        <p style="font-size:15px;">
            Bonjour <t t-out="object.partner_id.name or ''"/>,
        </p>
        <p style="font-size:15px;">
            Votre expérience nous importe. Auriez-vous deux minutes pour
            répondre à quelques questions&#160;? Vos réponses nous aident
            directement à améliorer nos services.
        </p>
        <div style="text-align:center; margin:28px 0;">
            <a t-att-href="object.get_start_url()"
               style="background-color:#29ABE1; color:#FFFFFF; text-decoration:none; padding:12px 28px; border-radius:6px; font-size:15px; display:inline-block;">
                Répondre au sondage
            </a>
        </div>
        <t t-if="object.deadline">
            <p style="font-size:13px; color:#6c757d;">
                Le sondage est ouvert jusqu'au
                <t t-out="format_date(object.deadline)"/>.
            </p>
        </t>
        <p style="font-size:15px;">
            Merci beaucoup&#160;!
        </p>
    </div>
</div>
            </field>
        </record>

        <!-- Short, differentiated reminder (a "last call" performs better
             than resending the identical invitation). -->
        <record id="mail_template_cx_reminder" model="mail.template">
            <field name="name">Expérience client : rappel de sondage</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Petit rappel — 2 minutes pour nous aider</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="background-color:#F8FAFC; padding:24px; font-family:Arial, Helvetica, sans-serif; color:#2D3031;">
    <div style="max-width:560px; margin:0 auto; background-color:#FFFFFF; border-radius:8px; padding:32px;">
        <p style="font-size:15px;">
            Bonjour <t t-out="object.partner_id.name or ''"/>,
        </p>
        <p style="font-size:15px;">
            Un petit rappel — votre avis nous aiderait vraiment, et il ne
            faut que deux minutes. C'est le seul rappel que vous recevrez.
        </p>
        <div style="text-align:center; margin:28px 0;">
            <a t-att-href="object.get_start_url()"
               style="background-color:#29ABE1; color:#FFFFFF; text-decoration:none; padding:12px 28px; border-radius:6px; font-size:15px; display:inline-block;">
                Répondre au sondage
            </a>
        </div>
        <p style="font-size:15px;">
            Merci beaucoup&#160;!
        </p>
    </div>
</div>
            </field>
        </record>

        <!-- Complaint acknowledgement (ISO 10002: prompt AR). Sent by the
             « Accuser réception » button, never automatically. -->
        <record id="mail_template_complaint_ack" model="mail.template">
            <field name="name">Expérience client : accusé de réception de plainte</field>
            <field name="model_id" ref="model_bf_cx_complaint"/>
            <field name="subject">Nous avons bien reçu votre plainte ({{ object.number }})</field>
            <field name="partner_to">{{ object.partner_id.id or '' }}</field>
            <field name="email_to">{{ '' if object.partner_id else (object.contact_email or '') }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="background-color:#F8FAFC; padding:24px; font-family:Arial, Helvetica, sans-serif; color:#2D3031;">
    <div style="max-width:560px; margin:0 auto; background-color:#FFFFFF; border-radius:8px; padding:32px;">
        <p style="font-size:15px;">
            Bonjour <t t-out="object.partner_id.name or object.contact_name or ''"/>,
        </p>
        <p style="font-size:15px;">
            Nous accusons réception de votre plainte
            (référence <b t-out="object.number"/>) concernant :
            «&#160;<t t-out="object.name"/>&#160;».
        </p>
        <p style="font-size:15px;">
            Elle est prise en charge dès maintenant. Nous vous revenons avec
            notre analyse et la suite à donner dans les meilleurs délais.
        </p>
        <p style="font-size:15px;">
            Merci de nous l'avoir signalée — c'est ce qui nous permet de
            nous améliorer.
        </p>
    </div>
</div>
            </field>
        </record>
    </data>
</odoo>
