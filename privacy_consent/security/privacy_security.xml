<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Catégorie du module -->
        <record id="module_privacy_category" model="ir.module.category">
            <field name="name">Vie privée (Loi 25)</field>
            <field name="description">Gestion de la vie privée et du consentement pour la conformité à la Loi 25</field>
            <field name="sequence">50</field>
        </record>

        <!-- Groupes de sécurité -->
        <record id="group_privacy_user" model="res.groups">
            <field name="name">Utilisateur vie privée</field>
            <field name="comment">Peut consulter les enregistrements de consentement et en créer de nouveaux.</field>
            <field name="category_id" ref="module_privacy_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_privacy_manager" model="res.groups">
            <field name="name">Gestionnaire vie privée</field>
            <field name="comment">Accès complet à tous les enregistrements de vie privée. Peut configurer les finalités et avis.</field>
            <field name="category_id" ref="module_privacy_category"/>
            <field name="implied_ids" eval="[(4, ref('group_privacy_user'))]"/>
        </record>

        <record id="group_privacy_officer" model="res.groups">
            <field name="name">Responsable vie privée</field>
            <field name="comment">Accès administrateur. Peut exporter les données et gérer toute la configuration.</field>
            <field name="category_id" ref="module_privacy_category"/>
            <field name="implied_ids" eval="[(4, ref('group_privacy_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Règles d'enregistrement -->

        <!-- Consentement : Règle de société (global) -->
        <record id="rule_consent_company" model="ir.rule">
            <field name="name">Consentement : Règle de société</field>
            <field name="model_id" ref="model_privacy_consent"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Finalité : Règle de société (global) -->
        <record id="rule_purpose_company" model="ir.rule">
            <field name="name">Finalité : Règle de société</field>
            <field name="model_id" ref="model_privacy_purpose"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Préférence : Règle de société (global) -->
        <record id="rule_preference_company" model="ir.rule">
            <field name="name">Préférence : Règle de société</field>
            <field name="model_id" ref="model_privacy_contact_preference"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Avis : Règle de société (global) -->
        <record id="rule_notice_company" model="ir.rule">
            <field name="name">Modèle de consentement : Règle de société</field>
            <field name="model_id" ref="model_privacy_notice"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Règles d'accès portail -->
        <record id="rule_consent_portal" model="ir.rule">
            <field name="name">Consentement : Accès portail</field>
            <field name="model_id" ref="model_privacy_consent"/>
            <field name="domain_force">[('subject_partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_preference_portal" model="ir.rule">
            <field name="name">Préférence : Accès portail</field>
            <field name="model_id" ref="model_privacy_contact_preference"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
