<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="bf_email_last_sync_date" model="ir.config_parameter">
        <field name="key">bf_email.last_sync_date</field>
        <field name="value">2000-01-01 00:00:00</field>
    </record>

    <record id="bf_email_sync_batch_size" model="ir.config_parameter">
        <field name="key">bf_email.sync_batch_size</field>
        <field name="value">200</field>
    </record>

    <!-- IMAP direct ingestion (host/port/user/password set via UI on first install) -->
    <record id="bf_email_imap_host" model="ir.config_parameter">
        <field name="key">bf_email.imap_host</field>
        <field name="value"></field>
    </record>

    <record id="bf_email_imap_port" model="ir.config_parameter">
        <field name="key">bf_email.imap_port</field>
        <field name="value">993</field>
    </record>

    <record id="bf_email_imap_user" model="ir.config_parameter">
        <field name="key">bf_email.imap_user</field>
        <field name="value"></field>
    </record>

    <record id="bf_email_imap_password" model="ir.config_parameter">
        <field name="key">bf_email.imap_password</field>
        <field name="value"></field>
    </record>

    <record id="bf_email_imap_batch_size" model="ir.config_parameter">
        <field name="key">bf_email.imap_batch_size</field>
        <field name="value">100</field>
    </record>

    <record id="bf_email_imap_last_uid_inbox" model="ir.config_parameter">
        <field name="key">bf_email.imap_last_uid_inbox</field>
        <field name="value">0</field>
    </record>

    <record id="bf_email_imap_last_uid_sent" model="ir.config_parameter">
        <field name="key">bf_email.imap_last_uid_sent</field>
        <field name="value">0</field>
    </record>

</odoo>
