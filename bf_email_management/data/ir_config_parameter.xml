<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- The chatter projection cron (_cron_sync_emails) still uses a global
         watermark on mail.message create_date — it doesn't read per-account
         credentials. Kept here for fresh installs. -->
    <record id="bf_email_last_sync_date" model="ir.config_parameter">
        <field name="key">bf_email.last_sync_date</field>
        <field name="value">2000-01-01 00:00:00</field>
    </record>

    <record id="bf_email_sync_batch_size" model="ir.config_parameter">
        <field name="key">bf_email.sync_batch_size</field>
        <field name="value">200</field>
    </record>

    <!--
      18.0.4.0.0: All IMAP credentials, watermarks, archive folders, batch
      sizes, and auto-link thresholds moved to bf.email.account (per-user).
      The migration in 18.0.4.0.0/post-migrate.py removes the legacy
      bf_email.imap_* rows from existing databases.
    -->

</odoo>
