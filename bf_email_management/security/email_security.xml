<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Per-user model (18.0.4.0.0):
      - No bf_email_management groups. Anyone with internal user access can
        configure their own bf.email.account rows and consume their own
        bf.email rows. No admin bypass for visibility.
      - One ir.rule per model with domain_force = [('user_id', '=', user.id)].
      - The migration in migrations/18.0.4.0.0/post-migrate.py drops the
        legacy group_email_user / group_email_manager records.
    -->

    <record id="bf_email_rule_owner" model="ir.rule">
        <field name="name">Courriel : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_account_rule_owner" model="ir.rule">
        <field name="name">Compte IMAP : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_account"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_rule_rule_owner" model="ir.rule">
        <field name="name">Règle courriel : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_rule"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
