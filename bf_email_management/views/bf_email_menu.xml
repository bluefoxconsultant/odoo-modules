<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root menu -->
    <menuitem id="menu_bf_email_root"
              name="Courriels"
              web_icon="bf_email_management,static/description/icon.png"
              sequence="45"/>

    <!-- Dashboard -->
