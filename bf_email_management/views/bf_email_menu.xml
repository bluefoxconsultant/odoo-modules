              sequence="90"/>

    <menuitem id="menu_bf_email_sync_now"
              name="Synchroniser maintenant"
              parent="menu_bf_email_config"
              action="action_bf_email_sync_now"
              sequence="5"/>

    <menuitem id="menu_bf_email_initial_sync"
              name="Import initial"
              parent="menu_bf_email_config"
              action="action_bf_email_initial_sync"
              sequence="10"/>

    <menuitem id="menu_bf_email_imap_backfill"
              name="Rattrapage IMAP (Archives)"
              parent="menu_bf_email_config"
