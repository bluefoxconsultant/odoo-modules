              sequence="10"/>

    <menuitem id="menu_bf_email_all"
              name="Tous les courriels"
              parent="menu_bf_email_emails"
              action="bf_email_action_all"
              sequence="20"/>

    <menuitem id="menu_bf_email_scheduled_drafts"
