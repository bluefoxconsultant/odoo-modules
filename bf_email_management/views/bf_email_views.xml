<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- TREE VIEW                                                    -->
    <!-- ============================================================ -->
    <record id="bf_email_view_tree" model="ir.ui.view">
        <field name="name">bf.email.tree</field>
        <field name="model">bf.email</field>
        <field name="arch" type="xml">
            <list decoration-bf="status == 'new'"
                  decoration-muted="status == 'archived'"
                  default_order="date desc">
                <header>
                    <button name="%(action_bf_email_sync_now)d"
                            string="Synchroniser maintenant"
                            type="action"
                            class="btn-primary"
                            icon="fa-refresh"
                            display="always"/>
                </header>
                <field name="direction" widget="badge"
                       decoration-info="direction == 'in'"
                       decoration-success="direction == 'out'"/>
                <field name="date" widget="datetime"/>
                <field name="partner_id" string="Contact"
                       optional="show"/>
                <field name="email_from" optional="show"/>
                <field name="email_to" optional="hide"/>
                <field name="subject"/>
                <field name="record_name" optional="show"/>
                <field name="category" widget="badge"
                       decoration-info="category == 'client'"
                       decoration-warning="category == 'vendor'"
                       decoration-success="category == 'internal'"
                       optional="show"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'chatter'"
                       decoration-muted="source == 'gateway'"
                       optional="hide"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'new'"
                       decoration-success="status == 'replied'"
                       decoration-muted="status == 'archived'"/>
                <field name="priority" widget="priority" optional="hide"/>
                <field name="has_attachments" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW                                                    -->
    <!-- ============================================================ -->
    <record id="bf_email_view_form" model="ir.ui.view">
        <field name="name">bf.email.form</field>
        <field name="model">bf.email</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reply"
                            string="R&#233;pondre"
                            type="object"
                            class="btn-primary"
                            icon="fa-reply"
                            invisible="not res_model"/>
                    <button name="action_mark_read"
                            string="Marquer lu"
                            type="object"
                            class="btn-secondary"
                            invisible="status != 'new'"/>
                    <button name="action_mark_replied"
                            string="Marquer r&#233;pondu"
                            type="object"
                            class="btn-secondary"
                            invisible="status in ('replied', 'archived')"/>
                    <button name="action_archive"
                            string="Archiver"
                            type="object"
                            class="btn-secondary"
                            invisible="status == 'archived'"/>
                    <button name="action_create_reminder"
                            string="Cr&#233;er un rappel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-bell"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,read,replied"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_reply"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-reply"
                                invisible="not res_model">
                            <div class="o_stat_info">
                                <span class="o_stat_text">R&#233;pondre</span>
                            </div>
                        </button>
                        <button name="action_open_in_chatter"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-comments"
                                invisible="not res_model">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Chatter</span>
                            </div>
                        </button>
                        <button name="action_open_source_record"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-external-link"
                                invisible="not res_model">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Enregistrement</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="subject" placeholder="(sans objet)"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Exp&#233;diteur / Destinataire">
                            <field name="direction"/>
                            <field name="email_from"/>
                            <field name="email_to"/>
                            <field name="email_cc"/>
                            <field name="date"/>
                        </group>
                        <group string="Enrichissement">
                            <field name="category"/>
                            <field name="source"/>
                            <field name="priority" widget="priority"/>
                            <field name="partner_id"/>
                            <field name="author_id"/>
                            <field name="response_time_hours"
                                   invisible="response_time_hours == 0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Corps" name="body">
                            <field name="body_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Pi&#232;ces jointes" name="attachments"
                              invisible="not has_attachments">
                            <field name="attachment_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="mimetype"/>
                                    <field name="file_size"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technique" name="technical">
                            <group>
                                <field name="message_id_header"/>
                                <field name="in_reply_to"/>
                                <field name="mail_message_id"/>
                                <field name="res_model"/>
                                <field name="res_id"/>
                                <field name="record_name"/>
                                <field name="has_attachments"/>
                                <field name="attachment_count"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW                                                  -->
    <!-- ============================================================ -->
    <record id="bf_email_view_search" model="ir.ui.view">
        <field name="name">bf.email.search</field>
        <field name="model">bf.email</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <field name="body_preview" string="Contenu"/>
                <field name="email_from"/>
                <field name="email_to"/>
                <field name="partner_id"/>
                <field name="record_name"/>
                <separator/>
                <filter name="filter_received"
                        string="Re&#231;us"
                        domain="[('direction', '=', 'in')]"/>
                <filter name="filter_sent"
                        string="Envoy&#233;s"
                        domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter name="filter_source_gateway"
                        string="Via passerelle"
                        domain="[('source', '=', 'gateway')]"/>
                <filter name="filter_source_chatter"
                        string="Via Chatter"
                        domain="[('source', '=', 'chatter')]"/>
                <separator/>
                <filter name="filter_new"
                        string="Non lus"
                        domain="[('status', '=', 'new')]"/>
                <filter name="filter_read"
                        string="Lus"
                        domain="[('status', '=', 'read')]"/>
                <filter name="filter_replied"
                        string="R&#233;pondus"
                        domain="[('status', '=', 'replied')]"/>
                <separator/>
                <filter name="filter_today"
                        string="Aujourd'hui"
                        domain="[('date', '>=', (context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="filter_week"
                        string="Cette semaine"
                        domain="[('date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="filter_month"
                        string="Ce mois-ci"
                        domain="[('date', '>=', (context_today()).strftime('%%Y-%%m-01'))]"/>
                <separator/>
                <filter name="filter_my_emails"
                        string="Mes courriels"
                        domain="[('author_id.user_ids', 'in', uid)]"/>
                <filter name="filter_no_record"
                        string="Sans enregistrement"
                        domain="[('res_model', '=', False)]"/>
                <filter name="filter_attachments"
                        string="Avec pi&#232;ces jointes"
                        domain="[('has_attachments', '=', True)]"/>
                <filter name="filter_archived"
                        string="Archiv&#233;s"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="group_direction"
                            string="Direction"
                            context="{'group_by': 'direction'}"/>
                    <filter name="group_category"
                            string="Cat&#233;gorie"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_source"
                            string="Source"
                            context="{'group_by': 'source'}"/>
                    <filter name="group_status"
                            string="Statut"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_partner"
                            string="Contact"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_model"
                            string="Mod&#232;le"
                            context="{'group_by': 'res_model'}"/>
                    <filter name="group_date"
                            string="Date"
                            context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- KANBAN VIEW                                                  -->
    <!-- ============================================================ -->
    <record id="bf_email_view_kanban" model="ir.ui.view">
        <field name="name">bf.email.kanban</field>
        <field name="model">bf.email</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="direction"/>
                <field name="status"/>
                <field name="category"/>
                <field name="has_attachments"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top mb-1">
                                <strong>
                                    <t t-if="record.direction.raw_value == 'in'">&#8592; </t>
                                    <t t-else="">&#8594; </t>
                                    <field name="email_from" class="text-truncate"/>
                                </strong>
                            </div>
                            <div class="text-truncate mb-1">
                                <field name="subject"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <field name="date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="category" widget="badge"
                                           invisible="not category"/>
                                    <t t-if="record.has_attachments.raw_value">
                                        <i class="fa fa-paperclip" title="Pi&#232;ces jointes"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- GRAPH VIEW                                                   -->
    <!-- ============================================================ -->
    <record id="bf_email_view_graph" model="ir.ui.view">
        <field name="name">bf.email.graph</field>
        <field name="model">bf.email</field>
        <field name="arch" type="xml">
            <graph string="Volume de courriels" type="bar">
                <field name="date" interval="day"/>
                <field name="direction" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- PIVOT VIEW                                                   -->
    <!-- ============================================================ -->
    <record id="bf_email_view_pivot" model="ir.ui.view">
        <field name="name">bf.email.pivot</field>
        <field name="model">bf.email</field>
        <field name="arch" type="xml">
            <pivot string="Analyse courriels">
                <field name="date" interval="month" type="row"/>
                <field name="direction" type="col"/>
                <field name="category" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION                                                       -->
    <!-- ============================================================ -->
    <!-- ============================================================ -->
    <!-- SERVER ACTIONS (mass actions from list)                     -->
    <!-- ============================================================ -->
    <record id="action_bf_email_mark_read" model="ir.actions.server">
        <field name="name">Marquer lu</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="binding_model_id" ref="model_bf_email"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_mark_read()</field>
    </record>

    <record id="action_bf_email_mark_replied" model="ir.actions.server">
        <field name="name">Marquer r&#233;pondu</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="binding_model_id" ref="model_bf_email"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_mark_replied()</field>
    </record>

    <record id="action_bf_email_archive" model="ir.actions.server">
        <field name="name">Archiver</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="binding_model_id" ref="model_bf_email"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_archive()</field>
    </record>

    <record id="action_bf_email_sync_now" model="ir.actions.server">
        <field name="name">Synchroniser maintenant</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_now()</field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTIONS                                                      -->
    <!-- ============================================================ -->
    <record id="bf_email_action" model="ir.actions.act_window">
        <field name="name">Courriels</field>
        <field name="res_model">bf.email</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="bf_email_view_search"/>
        <field name="context">{'search_default_filter_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun courriel synchronis&#233;
            </p>
            <p>
                Lancez la synchronisation initiale depuis le menu Configuration
                pour importer les courriels existants.
            </p>
        </field>
    </record>

    <record id="bf_email_action_all" model="ir.actions.act_window">
        <field name="name">Tous les courriels</field>
        <field name="res_model">bf.email</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="bf_email_view_search"/>
    </record>

    <record id="bf_email_action_graph" model="ir.actions.act_window">
        <field name="name">Volume de courriels</field>
        <field name="res_model">bf.email</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="search_view_id" ref="bf_email_view_search"/>
    </record>

    <record id="bf_email_action_pivot" model="ir.actions.act_window">
        <field name="name">Analyse courriels</field>
        <field name="res_model">bf.email</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="bf_email_view_search"/>
    </record>

</odoo>
