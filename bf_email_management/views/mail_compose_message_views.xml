<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add explicit À / C.c. / C.c.i. fields when bf_email_split_recipients is on. -->
    <record id="bf_email_compose_message_wizard_form" model="ir.ui.view">
        <field name="name">mail.compose.message.form.bf_split</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">

            <!-- Hide standard To label + field when split mode is on. -->
            <xpath expr="//label[@for='partner_ids']" position="attributes">
                <attribute name="invisible">composition_mode != 'comment' or subtype_is_log or bf_email_split_recipients</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_ids']/.." position="attributes">
                <attribute name="invisible">composition_mode != 'comment' or subtype_is_log or bf_email_split_recipients</attribute>
            </xpath>

            <!-- Insert split recipient fields right after the standard div. -->
            <xpath expr="//field[@name='partner_ids']/.." position="after">
                <field name="bf_email_split_recipients" invisible="1"/>
                <label for="bf_to_partner_ids" string="À"
                       invisible="not bf_email_split_recipients or composition_mode != 'comment' or subtype_is_log"/>
                <div groups="base.group_user"
                     invisible="not bf_email_split_recipients or composition_mode != 'comment' or subtype_is_log">
                    <field name="bf_to_partner_ids" widget="many2many_tags_email"
                           placeholder="Destinataire principal…"
                           options="{'no_quick_create': True}"
                           context="{'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"/>
                </div>
                <label for="bf_cc_partner_ids" string="C.c."
                       invisible="not bf_email_split_recipients or composition_mode != 'comment' or subtype_is_log"/>
                <div groups="base.group_user"
                     invisible="not bf_email_split_recipients or composition_mode != 'comment' or subtype_is_log">
                    <field name="bf_cc_partner_ids" widget="many2many_tags_email"
                           placeholder="Copie conforme…"
                           options="{'no_quick_create': True}"
                           context="{'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"/>
                </div>
                <label for="bf_bcc_partner_ids" string="C.c.i."
                       invisible="not bf_email_split_recipients or composition_mode != 'comment' or subtype_is_log"/>
                <div groups="base.group_user"
                     invisible="not bf_email_split_recipients or composition_mode != 'comment' or subtype_is_log">
                    <field name="bf_bcc_partner_ids" widget="many2many_tags_email"
                           placeholder="Copie conforme invisible…"
                           options="{'no_quick_create': True}"
                           context="{'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
