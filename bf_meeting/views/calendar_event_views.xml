<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend calendar.event form to add meeting record link -->
    <record id="calendar_event_view_form_inherit_meeting" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.meeting</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_meeting_record" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="meeting_record_count == 0">
                    <field name="meeting_record_count" widget="statinfo" string="Compte rendu"/>
                </button>
                <button name="action_create_meeting_record" type="object"
                        class="oe_stat_button" icon="fa-plus-circle"
                        invisible="meeting_record_count > 0">
                    <span class="o_stat_text">Créer compte rendu</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
