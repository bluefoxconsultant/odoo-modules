<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_meeting" model="ir.module.category">
            <field name="name">Rencontres</field>
            <field name="sequence">34</field>
        </record>

        <record id="group_meeting_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="comment">Peut consulter et modifier les comptes rendus des projets auxquels il a accès.</field>
            <field name="category_id" ref="module_category_meeting"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="group_meeting_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="comment">Accès complet à tous les comptes rendus.</field>
            <field name="category_id" ref="module_category_meeting"/>
            <field name="implied_ids" eval="[(4, ref('bf_meeting.group_meeting_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- Meeting records: users see only meetings of their projects -->
        <record id="rule_meeting_record_user" model="ir.rule">
            <field name="name">Comptes rendus : Membres du projet</field>
            <field name="model_id" ref="model_meeting_record"/>
            <field name="domain_force">[
                '|',
                ('project_id', '=', False),
                ('project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_meeting_record_manager" model="ir.rule">
            <field name="name">Comptes rendus : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_meeting_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
        </record>

        <!-- Decisions: follow meeting access -->
        <record id="rule_meeting_decision_user" model="ir.rule">
            <field name="name">Décisions : Membres du projet</field>
            <field name="model_id" ref="model_meeting_decision"/>
            <field name="domain_force">[
                '|',
                ('meeting_id.project_id', '=', False),
                ('meeting_id.project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_meeting_decision_manager" model="ir.rule">
            <field name="name">Décisions : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_meeting_decision"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
        </record>

        <!-- Topics: follow meeting access -->
        <record id="rule_meeting_topic_user" model="ir.rule">
            <field name="name">Sujets : Membres du projet</field>
            <field name="model_id" ref="model_meeting_topic"/>
            <field name="domain_force">[
                '|',
                ('meeting_id.project_id', '=', False),
                ('meeting_id.project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_meeting_topic_manager" model="ir.rule">
            <field name="name">Sujets : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_meeting_topic"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
        </record>

        <!-- Agendas: follow project access -->
        <record id="rule_meeting_agenda_user" model="ir.rule">
            <field name="name">Ordres du jour : Membres du projet</field>
            <field name="model_id" ref="model_meeting_agenda"/>
            <field name="domain_force">[
                '|',
                ('project_id', '=', False),
                ('project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_meeting_agenda_manager" model="ir.rule">
            <field name="name">Ordres du jour : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_meeting_agenda"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
        </record>

        <!-- Agenda topics: follow agenda access -->
        <record id="rule_meeting_agenda_topic_user" model="ir.rule">
            <field name="name">Sujets OdJ : Membres du projet</field>
            <field name="model_id" ref="model_meeting_agenda_topic"/>
            <field name="domain_force">[
                '|',
                ('agenda_id.project_id', '=', False),
                ('agenda_id.project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_meeting_agenda_topic_manager" model="ir.rule">
            <field name="name">Sujets OdJ : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_meeting_agenda_topic"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
        </record>

        <!-- Attendance: follow meeting access -->
        <record id="rule_meeting_attendance_user" model="ir.rule">
            <field name="name">Présences : Membres du projet</field>
            <field name="model_id" ref="model_meeting_attendance"/>
            <field name="domain_force">[
                '|',
                ('meeting_id.project_id', '=', False),
                ('meeting_id.project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_meeting_attendance_manager" model="ir.rule">
            <field name="name">Présences : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_meeting_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
        </record>

    </data>
</odoo>
