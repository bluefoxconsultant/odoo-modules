<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Activer la mise en sourdine CalDAV</field>
        <field name="description">Choisissez les calendriers et les fenêtres horaires pour activer le snooze automatique des notifications.</field>
        <field name="button_text">Ouvrir Paramètres</field>
        <field name="done_text">Snooze actif</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Calendar Snooze</field>
        <field name="route_name">bf_calendar_caldav_snooze_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_calendar_caldav_snooze</field>
        <field name="step_ids" eval="[Command.link(ref('bf_calendar_caldav_snooze.bf_onb_step_settings'))]"/>
    </record>
</odoo>
