<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal users can read public booking types -->
    <record id="rule_booking_type_public_portal" model="ir.rule">
        <field name="name">Public booking types: portal read</field>
        <field name="model_id" ref="resource_booking.model_resource_booking_type"/>
        <field name="domain_force">[('is_public', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Public users can read public booking types -->
    <record id="rule_booking_type_public_anonymous" model="ir.rule">
        <field name="name">Public booking types: anonymous read</field>
        <field name="model_id" ref="resource_booking.model_resource_booking_type"/>
        <field name="domain_force">[('is_public', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
